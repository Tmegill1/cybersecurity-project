# Flask Dashboard - Base image with Python dependencies
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install sqlite3 (needed for SQLite backend)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        sqlite3 \
        curl \
        && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY dashboard/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY dashboard/app.py ./
COPY dashboard/routes ./routes
COPY dashboard/templates ./templates
COPY db/schema.sql ./db/

# Create SQLite database directory
RUN mkdir -p /app/db && touch /app/db/soc_station.db

# Expose Flask port
EXPOSE 5000

# Run with HTMX-ready app
CMD ["python", "app.py"]
